# Only for running stage 1 from your machine. Copy to terraform.tfvars (git-ignored) and fill in.
# Team values that are not secret already live in terraform.auto.tfvars; CI passes the rest as TF_VAR_*.

org_id          = "123456789012"
billing_account = "ABCDEF-123456-7890AB"
environment     = "shared"
state_bucket    = "bnt-b-seed-tfstate-xxxx" # output state_bucket of stage 0

# Emails for budget alerts and Essential Contacts (in CI: the ALERT_EMAILS secret).
alert_emails = ["someone@example.com"]
