# Copy to terraform.tfvars and fill in. Never commit tfvars with real values (see .gitignore).
# All of these must agree with the values you used in stage 0 (org_id, billing_account,
# project_prefix, parent_folder, primary_region, dr_region).

org_id          = "123456789012"
billing_account = "ABCDEF-123456-7890AB"
environment     = "shared"
project_prefix  = "dc"

# Leave empty to create everything under the org root. When using a sandbox inside a real org,
# set this to the numeric ID of your sandbox folder, same value as stage 0.
parent_folder = ""

# State bucket name output by stage 0 (seed-tfstate).
state_bucket = "dc-b-seed-tfstate"

primary_region = "northamerica-south1"
dr_region      = "us-south1"

labels = {
  owner       = "iac-team"
  cost_center = "ti-001"
}

# Sandbox-safe defaults. For prod cutover, set audit_log_retention_locked = true (one-way).
audit_log_retention_days   = 400
audit_log_retention_locked = false

# Safe-mode sandbox: let Terraform delete folders and projects on destroy. Flip to true + PREVENT
# before prod cutover.
folder_deletion_protection = false
project_deletion_policy    = "DELETE"

# Budgets — override in sandbox if you want louder/quieter alerts.
budget_currency                      = "USD"
budget_common_project_monthly_amount = 100
budget_env_monthly_amount = {
  dev  = 300
  qa   = 500
  prod = 2000
}
