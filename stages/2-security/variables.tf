# Stage 2 variables. Shared ones (org_id, billing_account, environment, regions, labels,
# state_bucket) come from variables_common.tf (copied from stages/_shared/).

variable "project_prefix" {
  description = "Short company prefix used in resource names. Must match stages 0 and 1."
  type        = string
  default     = "bnt"

  validation {
    condition     = can(regex("^[a-z][a-z0-9]{1,2}$", var.project_prefix))
    error_message = "project_prefix must be 2-3 lowercase letters/digits and start with a letter."
  }
}

variable "pipeline_sa_project_id" {
  description = "Project ID of stage 0's seed project, where the pipeline service accounts live (sa-terraform-<stage>@<this>.iam.gserviceaccount.com)."
  type        = string

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{4,28}[a-z0-9]$", var.pipeline_sa_project_id))
    error_message = "pipeline_sa_project_id must be a valid project ID (output seed_project_id of stage 0)."
  }
}

variable "security_reader_groups" {
  description = "Groups (emails, without the group: prefix) that may SEE keys and secret metadata, never secret values. People go in groups, not in IAM (spec)."
  type        = list(string)
  default     = []

  validation {
    condition     = alltrue([for g in var.security_reader_groups : can(regex("^[^@ :]+@[^@ ]+[.][^@ ]+$", g))])
    error_message = "Every security_reader_groups entry must be a group email such as grp-seguridad@example.com."
  }
}

# --- Cloud KMS ---------------------------------------------------------------------------------------------

variable "kms_keys" {
  description = "Keys created in each key ring (primary and DR region). One per kind of data that later stages encrypt with CMEK."
  type        = list(string)
  default     = ["storage", "sql", "gke"]
}

variable "kms_rotation_period" {
  description = "Automatic rotation of every key. Spec: 90 days (7776000s)."
  type        = string
  default     = "7776000s"
}

variable "kms_protection_level" {
  description = "SOFTWARE (0.06 USD per key version per month) or HSM (1-2.50 USD). SOFTWARE in the sandbox."
  type        = string
  default     = "SOFTWARE"
}

variable "kms_destroy_scheduled_duration" {
  description = "Delay before a destroyed key version is gone for good. 1 day (the minimum) in the sandbox."
  type        = string
  default     = "86400s"
}

# --- Secret Manager ----------------------------------------------------------------------------------------

variable "secrets" {
  description = <<-EOT
    Secrets generated by this stage, by short name. The value is random and never stored in the plan or state.
      app       label of the secret
      accessors stages whose pipeline SA may read the value (org, security, networks, projects, workloads)
      length    / special: shape of the generated value
      version   bump it to rotate (writes a new version with a new random value)
  EOT
  type = map(object({
    app       = string
    accessors = list(string)
    length    = optional(number, 32)
    special   = optional(bool, false)
    version   = optional(number, 1)
  }))
  default = {
    vpn-psk-onprem = { app = "hybrid-connectivity", accessors = ["networks"] }
    sql-admin-pass = { app = "cloud-sql", accessors = ["workloads"] }
  }

  validation {
    condition = alltrue(flatten([
      for s in values(var.secrets) : [for a in s.accessors : contains(["org", "security", "networks", "projects", "workloads"], a)]
    ]))
    error_message = "accessors must be stage names: org, security, networks, projects or workloads."
  }

  validation {
    condition     = alltrue([for s in values(var.secrets) : s.length >= 16 && s.version >= 1])
    error_message = "Secrets need length >= 16 and version >= 1."
  }
}

# --- VPC Service Controls ----------------------------------------------------------------------------------

variable "access_policy_id" {
  description = "Number of an existing organization access policy. Empty: this stage creates it (an org can only have one)."
  type        = string
  default     = ""

  validation {
    condition     = var.access_policy_id == "" || can(regex("^[0-9]+$", var.access_policy_id))
    error_message = "access_policy_id must be empty or the numeric policy ID."
  }
}

variable "vpc_sc_enforce" {
  description = "false: the perimeter is dry-run only (logs violations, blocks nothing). Set true only after reading the dry-run logs."
  type        = bool
  default     = false
}

variable "vpc_sc_restricted_services" {
  description = "APIs protected by the prod perimeter."
  type        = list(string)
  default = [
    "storage.googleapis.com",
    "bigquery.googleapis.com",
    "sqladmin.googleapis.com",
    "container.googleapis.com",
  ]

  validation {
    condition     = alltrue([for s in var.vpc_sc_restricted_services : endswith(s, ".googleapis.com")])
    error_message = "Restricted services are API names such as storage.googleapis.com."
  }
}
