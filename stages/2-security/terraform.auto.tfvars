# Non-secret values for stage 2, committed so GitHub Actions uses them (terraform.tfvars is git-ignored).
# org_id, billing_account, state_bucket and environment come from the pipeline (TF_VAR_*).
# Never put secrets here: the repository is public. Secret values are generated by Terraform (secrets.tf).

project_prefix = "bnt"

# Seed project of stage 0 (output seed_project_id), home of the pipeline service accounts.
pipeline_sa_project_id = "bnt-b-seed-5d99"

labels = {
  owner       = "equipo6"
  cost_center = "ti-001"
}

# People who may see keys and secret metadata (not secret values).
security_reader_groups = ["grp-seguridad@banorterra.com"]

# Sandbox: software keys (cheap), 90-day rotation, 1-day destroy delay. Perimeter in dry-run.
kms_protection_level           = "SOFTWARE"
kms_rotation_period            = "7776000s"
kms_destroy_scheduled_duration = "86400s"
vpc_sc_enforce                 = false
