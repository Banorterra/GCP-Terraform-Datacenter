# Example values for one environment, following the spec's variable table.
# Real files live next to each root as terraform.auto.tfvars (non-secret, committed). Never put secrets here.
org_id          = "123456789012"
billing_account = "ABCDEF-123456-7890AB"
environment     = "prod"
primary_region  = "northamerica-south1" # Queretaro (ADR 0005)
dr_region       = "us-south1"           # Dallas (ADR 0005)

# IP plan from the network diagram (Phase 3, diagram 2):
#   hub  10.0.0.0/22 | prod 10.10.0.0/16 | dev 10.20.0.0/16 | qa 10.30.0.0/16
# Each environment has one /20 per service project in the primary region and, in prod only,
# a /17 reserved for the DR replica in the DR region.
subnet_cidrs = {
  canales = "10.10.0.0/20"
  core    = "10.10.16.0/20"
  datos   = "10.10.32.0/20"
  dr      = "10.10.128.0/17"
}

# Banorte on-premises range. Must not overlap any subnet above or the hub.
onprem_cidrs = ["172.16.0.0/16"]

gke_node_pools = {
  general = {
    machine_type = "e2-standard-4"
    min          = 2
    max          = 10
  }
}

sql_tier = "db-custom-4-16384"

# Label values must be lowercase in GCP: the spec's "TI-001" has to be written "ti-001".
labels = {
  owner       = "platform-team"
  cost_center = "ti-001"
}
