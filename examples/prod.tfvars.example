# Example values for one environment, following the spec's variable table.
# Real files live next to each root as terraform.auto.tfvars (non-secret, committed). Never put secrets here.
org_id          = "123456789012"
billing_account = "ABCDEF-123456-7890AB"
environment     = "prod"
primary_region  = "us-central1"
dr_region       = "us-east4"

subnet_cidrs = {
  app = "10.30.0.0/20"
}

# Must not overlap any subnet above (client delivers the IP plan before Sprint 3).
onprem_cidrs = ["192.168.0.0/16"]

gke_node_pools = {
  general = {
    machine_type = "e2-standard-4"
    min          = 2
    max          = 10
  }
}

sql_tier = "db-custom-4-16384"

# Label values must be lowercase in GCP: the spec's "TI-001" has to be written "ti-001".
labels = {
  owner       = "platform-team"
  cost_center = "ti-001"
}
